		sourceColumn: Meses

	partition Okun = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\Usuario\Documents\claude\banco_central\banco_central.xlsx"), null, true),
				    Hoja = Source{[Item="okun",Kind="Sheet"]}[Data],
				    Headers = Table.PromoteHeaders(Hoja, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Rezago", Int64.Type}, {"Correlacion", type number}, {"Pendiente", type number}, {"Intercepto", type number}, {"R2", type number}, {"CrecimientoNeutral", type number}, {"PendienteSinPandemia", type number}, {"R2SinPandemia", type number}, {"Meses", Int64.Type}})
