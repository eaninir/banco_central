/// Resultados de la ley de Okun (una fila)
table Okun
	lineageTag: 96e22d97-d674-4d1f-800d-c705ec4ec51b

	/// Meses que tarda el desempleo en reaccionar al crecimiento
	measure 'Rezago Óptimo' = MAX('Okun'[Rezago])
		formatString: 0" mes(es)"
		lineageTag: f6e10172-5fbe-47ff-85f2-96883a9509e8

	measure 'Correlación Óptima' = MAX('Okun'[Correlacion])
		formatString: +0.00;-0.00;0.00
		lineageTag: 343c0e12-c13d-4b55-b631-c379d130ab2d

	/// pp de desempleo por cada punto de crecimiento del Imacec
	measure 'Coeficiente Okun' = MAX('Okun'[Pendiente])
		formatString: +0.00" pp";-0.00" pp"
		lineageTag: 851f32d3-35bf-4b3d-a01e-94f8d693d6f0

	measure 'R² Okun' = MAX('Okun'[R2])
		formatString: 0.00
		lineageTag: 9480ca7a-692f-4fd7-88f4-bbcd0e659491

	/// Crecimiento del Imacec con el que la tasa de desempleo se mantiene estable
	measure 'Crecimiento Neutral' = MAX('Okun'[CrecimientoNeutral])
		formatString: 0.0"%"
		lineageTag: 37491a9d-a435-468d-9f05-1367865a4d84

	measure 'Coeficiente Okun sin Pandemia' = MAX('Okun'[PendienteSinPandemia])
		formatString: +0.00" pp";-0.00" pp"
		lineageTag: 37a317d9-5c5c-4ffa-9acc-6db90b79ba7d

	column Rezago
		dataType: int64
		lineageTag: a65a0384-208d-4339-8b7d-bfc4b2773b49
		summarizeBy: none
		sourceColumn: Rezago

	column Correlacion
